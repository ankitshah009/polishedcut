# PolishedCut: every variable the code reads. Copy to .env. Nothing is required: with no key at all the
# free local editor cuts (whisper.cpp + ffmpeg, lib/local-editor.ts).
#
# Which editor cuts (lib/config.ts MODEL_PROVIDER; unset = nebula if NEBULA_* are set, else gemini if a
# GEMINI key is set, else local):
# MODEL_PROVIDER=local                       # local | gemini | nebula
# WHISPER_MODEL=models/ggml-base.en.bin      # whisper.cpp ggml model for local transcripts (brew install whisper-cpp)
# WHISPER_BIN=whisper-cli
#
# Nebula-hosted models: a Gemini-protocol gateway (same SDK, different host). The ids are Nebula's.
# NEBULA_BASE_URL=                           # e.g. https://<gateway>/  (must speak the Gemini REST API incl. Files)
# NEBULA_API_KEY=
# NEBULA_MODEL=google:gemini-3.8-flash       # main cut model (draft, critique, patch) under the nebula provider
# NEBULA_FALLBACK_MODEL=google:gemini-4-argon # tried when NEBULA_MODEL errors
# GENAI_BASE_URL=                            # any other Gemini-compatible endpoint, for the gemini provider
#
# Google directly:
# Defaults shown are the values used when a line is left unset. Invalid numbers fall back to the
# default with a warning at startup (lib/config.ts).

# --- Gemini keys (lib/gemini.ts) --------------------------------------------------------------
GEMINI_API_KEY=
# Optional second key, tried after GEMINI_API_KEY. GEMINI_KEY_ORDER=1 puts it first.
# GEMINI_API_KEY_1=
# GEMINI_KEY_ORDER=0

# --- Models (lib/config.ts, lib/art.ts, lib/brief.ts) ------------------------------------------
# ARGON_MODEL=gemini-4-argon                 # draft, critique, patch (thinking_level medium)
# TRANSCRIBE_MODEL=gemini-3.5-transcribe     # word-timed transcripts
# FLASH_MODEL=gemini-3.8-flash               # transcription fallback
# BRIEF_MODEL=gemini-3.5-flash-lite          # brief analysis (target length, tone, music mood)
# ART_MODEL=gemini-nano-banana-2.1           # title-card background plate
# OMNI_MODEL=gemini-omni-1.1-flash           # generated B-roll shots (lib/broll.ts)
# Lyria model ids are fixed in lib/music.ts: lyria-3-clip-preview (<=30s) and lyria-3.5 (longer beds).
# LLM_TIMEOUT_MS=900000                      # per model call / Files API upload, 15 min

# --- Paths (lib/config.ts) ---------------------------------------------------------------------
# RUNS_DIR=runs                              # run folders, run.json, proxies, renders, .upload_cache.json
# DEMO_DIR=footage/demo                      # clips for "Try the demo clips"; may hold brief.txt
# DEMO_BRIEF=                                # overrides DEMO_DIR/brief.txt and the built-in demo brief

# --- Loop and render (lib/config.ts) -----------------------------------------------------------
# MAX_ITERATIONS=3                           # render -> critique -> patch rounds per cut
# REVISE_MAX_ITERATIONS=2                    # extra rounds after a director's note
# MIN_CUT_SECONDS=0.3                        # cuts shorter than this after clamping are dropped
# OUTPUT_WIDTH=1280
# OUTPUT_HEIGHT=720
# OUTPUT_FPS=30
# PROXY_HEIGHT=480                           # height of the proxies uploaded for the model to watch
# PHOTO_SECONDS=4                            # length of the Ken Burns clip a still photo becomes
# EXEC_MAX_BUFFER=16777216                   # stdout/stderr buffer for ffmpeg/ffprobe children

# --- HTTP limits (lib/config.ts) ---------------------------------------------------------------
# MAX_UPLOAD_BYTES=2147483648                # POST /api/runs body limit; over it -> 413
# BRIEF_MAX_CHARS=2000
# NOTE_MAX_CHARS=500                         # director's note length
# SSE_HEARTBEAT_MS=15000                     # ": ping" comment on idle /events streams

# --- Pricing estimates, USD (lib/pricing.ts) ---------------------------------------------------
# PRICE_ARGON_IN_PER_M=2                     # published hackathon rate
# PRICE_ARGON_OUT_PER_M=10
# PRICE_FLASH_IN_PER_M=0.5                   # assumed
# PRICE_FLASH_OUT_PER_M=3
# PRICE_TRANSCRIBE_IN_PER_M=1                # assumed
# PRICE_TRANSCRIBE_OUT_PER_M=4
# PRICE_LYRIA_PER_CALL=0.1                   # assumed, per request
# PRICE_CACHED_MULTIPLIER=0.25               # cached prompt tokens as a fraction of the input price
# COST_PER_CUT_USD=                          # overrides the modelled cost of one cut (set from measured runs)
# PLAN_FREE_CUTS=3
# PLAN_CREATOR_USD=19
# PLAN_CREATOR_CUTS=40
# PLAN_STUDIO_USD=79
# PLAN_STUDIO_CUTS=200
# PLAN_PAYG_USD=0.99

# --- Scaling: any footage, Google handshake (lib/config.ts; see docs/SCALING.md) ---------------
# PROXY_LONG_EDGE=854                        # long edge of the proxies the model watches; portrait stays portrait (480x854)
# PROXY_FPS=30                               # proxies are re-timed to a constant frame rate (VFR phone footage)
# MAX_CLIP_SECONDS=1800                      # one uploaded clip longer than this -> 400 at upload (30 min)
# MAX_TOTAL_SECONDS=7200                     # all clips of one run together -> 400 at upload (2 h)
# GEMINI_CONCURRENCY=4                       # Gemini requests in flight at once (Interactions + Files API)
# KEEP_UPLOADS=0                             # 1 keeps a run's proxies in the Files API; default deletes them when the run ends
# ORPHAN_AFTER_MS=90000                      # quiet in-progress run with no loop behind it -> "Interrupted"
# Output size is not configured: it follows the footage (1920x1080 / 1080x1920 / 1080x1080) and the brief
# ("vertical", "9:16", "square", "4K"). OUTPUT_WIDTH/HEIGHT above are only the fallback when nothing can be probed.

# --- UI (components/shell/Dashboard.tsx; NEXT_PUBLIC_ is inlined at build time) ----------------
# NEXT_PUBLIC_USER_NAME=                     # name in the dashboard greeting

# --- Legacy Python prototype only (editor/, scripts/dev.sh) ------------------------------------
# PORT=8080
# EDITOR_MOCK=0
# EDITOR_RUNS_DIR=runs

# --- Chat front door: Photon Beta 2.0 (lib/photon.ts, lib/photon-handler.ts; docs/PHOTON.md) ------------
# Text a clip and a one-line brief to the agent's iMessage / Telegram / WhatsApp line and get the cut back in
# the same chat. Targets https://app.beta.photon.codes (HTTP API api.photon.codes + Socket.IO events), not the
# Stable spectrum-ts SDK. Off unless both PHOTON_PROJECT_ID and PHOTON_API_KEY are set.
# PHOTON_PROJECT_ID=                         # pho_prj_… (Beta dashboard -> project -> Settings)
# PHOTON_API_KEY=                            # pho_sk_… project API key with project:read + project:write
#                                            # (PHOTON_SPECTRUM_API_KEY is read as a fallback name)
# PHOTON_API_URL=https://api.photon.codes    # documented base URL; the event stream uses the same origin
# PHOTON_API_VERSION=                        # optional event-contract date (e.g. 2026-07-01) pinned on subscribe
# PHOTON_MODE=stream                         # stream: Socket.IO from this process, no public URL needed
#                                            # webhook: Photon POSTs events to /api/photon/webhook (needs the secret below)
# PHOTON_WEBHOOK_SECRET=                     # signingSecret returned once by createWebhookDestination
# PHOTON_ENABLED=1                           # 0 keeps the adapter off even with credentials present
# PHOTON_SETTLE_MS=2500                      # wait after the last clip/brief before starting the cut (multi-clip sends)
# PHOTON_RUN_TIMEOUT_MS=1800000              # give up waiting for a cut after 30 min and say so in the chat
# PHOTON_MAX_ATTACHMENT_BYTES=99614720       # renders above ~95 MB are linked, not attached
# PHOTON_CURSOR_FILE=runs/.photon-cursor.json # Socket.IO replay cursor checkpoint
# PUBLIC_URL=                                # https origin of this app; adds a "watch every version" link to replies
#                                            # (and is the only way a video reaches Beta iMessage, which is text+images)
